# Local dev runs at the root (no Webflow Cloud mount path).
# Production (Webflow Cloud) defaults to "/app" via lib/site.ts.
NEXT_PUBLIC_BASE_PATH=
# Reservation mailing (Resend) — required for the reservation modal to send mail
RESEND_API_KEY=re_3TwGadPp_Miy3w8Z8szfza7CP3e9RLFtC
# Optional: verified sender + recipient overrides
RESEND_FROM="Glockenspiel Website <reservierung@dasglockenspiel.at>"
RESERVATION_TO=info@dasglockenspiel.at

# Google Maps Embed API key (falls back to the key in lib/site.ts)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Sanity CMS ──
# From your Sanity project (sanity.io/manage). Without these, the site builds
# from the committed content/*.json fallback.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Same values for the Studio (sanity dev/deploy reads SANITY_STUDIO_*)
SANITY_STUDIO_PROJECT_ID=7t1m8zq8
SANITY_STUDIO_DATASET=production
# Editor write token — ONLY needed to run `npm run sanity:seed` once. Do not commit a real value.
